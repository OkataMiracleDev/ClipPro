{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipPro",
  "version": "1.0.2",
  "identifier": "app.clippro.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build && cargo build --release -p clippro-cli",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipPro",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost clippro: http://clippro.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost clippro: http://clippro.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Miracle Okata",
    "copyright": "Copyright (c) 2026 Miracle Okata",
    "category": "Video",
    "shortDescription": "Footage selects for editors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "ClipPro"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "resources": {
      "../../third_party/ffmpeg/bin/avcodec-63.dll": "avcodec-63.dll",
      "../../third_party/ffmpeg/bin/avdevice-63.dll": "avdevice-63.dll",
      "../../third_party/ffmpeg/bin/avfilter-12.dll": "avfilter-12.dll",
      "../../third_party/ffmpeg/bin/avformat-63.dll": "avformat-63.dll",
      "../../third_party/ffmpeg/bin/avutil-61.dll": "avutil-61.dll",
      "../../third_party/ffmpeg/bin/swresample-7.dll": "swresample-7.dll",
      "../../third_party/ffmpeg/bin/swscale-10.dll": "swscale-10.dll",
      "../../third_party/ffmpeg/bin/ffmpeg.exe": "ffmpeg.exe",
      "../../target/release/DirectML.dll": "DirectML.dll",
      "licenses/NOTICE.md": "licenses/NOTICE.md",
      "licenses/FFMPEG-LICENSE.txt": "licenses/FFMPEG-LICENSE.txt",
      "licenses/THIRD-PARTY-RUST.md": "licenses/THIRD-PARTY-RUST.md",
      "licenses/THIRD-PARTY-JS.md": "licenses/THIRD-PARTY-JS.md",
      "../../target/release/clippro-cli.exe": "clippro-cli.exe",
      "../../LICENSE": "LICENSE.txt"
    },
    "license": "LicenseRef-MIT-Commons-Clause",
    "fileAssociations": [
      {
        "ext": [
          "clippro"
        ],
        "name": "ClipPro project",
        "description": "ClipPro project",
        "role": "Editor",
        "mimeType": "application/x-clippro"
      }
    ],
    "licenseFile": "../../LICENSE",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyMjQ5MjA2NDU2N0FGNkEKUldScXIyZEZCcElrNGsyWDZJanFmYzQwNHU4MWZvU3ovV29NL2pGMWpmNEx0T05UUG5jM2xvckEK",
      "endpoints": [
        "https://github.com/OkataMiracleDev/ClipPro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
