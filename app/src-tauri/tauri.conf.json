{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipPro",
  "version": "0.1.0",
  "identifier": "app.clippro.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipPro",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost clippro: http://clippro.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost clippro: http://clippro.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Miracle Okata",
    "copyright": "Copyright (c) 2026 Miracle Okata",
    "category": "Video",
    "shortDescription": "Footage selects for editors",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
